{
	"colors": {
		"#0a0a01": "var(--color-bg)",
		"#0a0a02": "var(--color-surface)",
		"#0a0a03": "var(--color-ink)",
		"#0a0a04": "var(--line)",
		"#0a0a05": "var(--color-dim)",
		"#0a0a06": "var(--sunk)",
		"#0a0a07": "var(--line-soft)",
		"#0a0a08": "var(--color-brand)"
	},
	"derived": {
		"rgba(10, 10, 1, 0.5)": "color-mix(in srgb, var(--color-bg) 50%, transparent)",
		"rgba(10, 10, 6, 0.5)": "color-mix(in srgb, var(--sunk) 50%, transparent)",
		"rgb(10, 10, 8)": "var(--color-brand)"
	},
	"named": {
		"fill=\"white\"": "fill=\"var(--color-bg)\""
	},
	"fonts": {
		"IBM Plex Mono,monospace": "var(--font-mono)"
	},
	"ignored": [
		"#000",
		"#000000"
	]
